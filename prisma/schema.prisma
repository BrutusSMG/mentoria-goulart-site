// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tabela para guardar o histórico de cotações
model CotacaoHistorico {
  id       String   @id @default(cuid())
  dolar    Float
  ouro     Float
  prata    Float
  platina  Float
  paladio  Float
  rodio    Float?
  criadoEm DateTime @default(now())
}

// Domínio consolidado de cotações da E3.4.
// Cada execução de coleta utiliza o mesmo coletaId para todos os metais.
enum MetalCotacao {
  OURO
  PRATA
  PLATINA
  PALADIO
  RODIO
}

enum StatusCotacaoMetal {
  SUCESSO
  PARCIAL
  INDISPONIVEL
  ERRO
}

model CotacaoMetal {
  id              String             @id @default(cuid())
  coletaId        String
  metal           MetalCotacao
  valorOriginal   Decimal?           @db.Decimal(18, 6)
  unidadeOriginal String?
  moedaOriginal   String?
  dolarBrl        Decimal?           @db.Decimal(12, 6)
  valorBrlGrama   Decimal?           @db.Decimal(18, 6)
  fonte           String
  fonteDolar      String?
  referenciaEm    DateTime?
  coletadoEm      DateTime           @default(now())
  status          StatusCotacaoMetal
  erro            String?            @db.Text
  createdAt       DateTime           @default(now())

  @@unique([coletaId, metal])
  @@index([coletaId])
  @@index([metal, coletadoEm])
  @@index([status])
  @@index([coletadoEm])
}

// Tabela para guardar os leads do site
model Lead {
  id                   String                @id @default(cuid())
  nome                 String
  email                String                @unique
  whatsapp             String?
  baixouEbook          Boolean               @default(false)
  comprouMentoria      Boolean               @default(false)
  comprouMentoriaEm    DateTime?
  jornadaContribuicoes JornadaContribuicao[]
  utmSource            String?
  utmMedium            String?
  utmCampaign          String?
  utmContent           String?
  utmTerm              String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  transacoesHotmart    HotmartTransaction[]
  aluno                Aluno?
  pessoaId             String?               @unique
  pessoa               Pessoa?               @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
}

model JornadaContribuicao {
  id             String  @id @default(cuid())
  leadId         String
  idempotencyKey String? @unique

  formVersion        String   @default("1.0")
  caminho            String
  respostas          Json
  produtosDeclarados String[] @default([])

  nomeInformado        String
  emailInformado       String
  whatsappInformado    String?
  cidadeEstado         String?
  tempoMentoria        String?
  dataCompraAproximada String?

  statusVinculo           String   @default("PENDENTE_VERIFICACAO")
  statusOperacional       String   @default("NOVA_RESPOSTA")
  tags                    String[] @default([])
  interesseEntrevista     String?
  consentimentoEntrevista Boolean  @default(false)
  consentimentoConteudo   Boolean  @default(false)
  melhorCanal             String?
  contatoPreferencial     String?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  observacoesInternas String?   @db.Text
  verificadoEm        DateTime?
  verificadoPor       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([statusVinculo])
  @@index([statusOperacional])
  @@index([caminho])
}

enum StatusAluno {
  PENDENTE_ACESSO
  ATIVO
  SUSPENSO
  INATIVO
}

enum OrigemAluno {
  HOTMART
  LEGADO
  MANUAL
}

enum OrigemMatricula {
  HOTMART
  LEGADO
  MANUAL
}

enum OrigemVigencia {
  HOTMART
  LEGADO
  MANUAL
}

enum TipoDuracaoVigencia {
  DEFINIDA
  INDEFINIDA
  VITALICIA
}

enum StatusVigenciaMatricula {
  AGENDADA
  ATIVA
  SUSPENSA
  CANCELADA
  ENCERRADA
}

enum StatusMatricula {
  PENDENTE
  ATIVA
  SUSPENSA
  CANCELADA
  ENCERRADA
}

enum VisibilidadePerfil {
  PRIVADO
  ALUNOS
}

enum TipoProduto {
  CURSO
  EBOOK
}

enum ProvedorProduto {
  HOTMART
}

enum TipoDireitoProduto {
  AREA_ALUNO
  COMUNIDADE
  MENTORIA
  CONTEUDO_PRODUTO
  ECOSSISTEMA
}

enum NivelEcossistema {
  NENHUM
  BASICO
  COMPLETO
  PREMIUM
}

enum OrigemDireitoConcedido {
  HOTMART
  LEGADO
  MANUAL
}

enum StatusDireitoConcedido {
  ATIVO
  REVOGADO
  EXPIRADO
}

model Aluno {
  id                     String      @id @default(cuid())
  leadId                 String?     @unique
  nome                   String
  email                  String      @unique
  whatsapp               String?
  senhaHash              String?
  status                 StatusAluno @default(PENDENTE_ACESSO)
  origem                 OrigemAluno @default(HOTMART)
  emailVerificadoEm      DateTime?
  conviteLegadoEnviadoEm DateTime?
  ultimoLoginEm          DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  lead               Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  matriculas         Matricula[]
  transacoesHotmart  HotmartTransaction[]
  perfil             PerfilAluno?
  tokensAcesso       AlunoAccessToken[]
  direitosConcedidos DireitoConcedido[]
  pessoaId           String?              @unique
  pessoa             Pessoa?              @relation(fields: [pessoaId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([origem])
  @@index([createdAt])
}

model Matricula {
  id           String          @id @default(cuid())
  alunoId      String
  produtoId    String
  produtoUcode String?
  produtoNome  String
  origem       OrigemMatricula @default(HOTMART)
  status       StatusMatricula @default(PENDENTE)
  concedidaEm  DateTime?
  suspensaEm   DateTime?
  encerradaEm  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  aluno             Aluno                @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  transacoesHotmart HotmartTransaction[]
  vigencias         VigenciaMatricula[]

  @@unique([alunoId, produtoId])
  @@index([alunoId])
  @@index([produtoId])
  @@index([status])
}

model VigenciaMatricula {
  id                      String                  @id @default(cuid())
  matriculaId             String
  transacaoOrigemId       String?                 @unique
  origem                  OrigemVigencia
  tipoDuracao             TipoDuracaoVigencia
  status                  StatusVigenciaMatricula
  concedidaEm             DateTime?
  iniciaEm                DateTime
  garantiaAte             DateTime?
  expiraEm                DateTime?
  statusAlteradoEm        DateTime                @default(now())
  canceladaEm             DateTime?
  encerradaEm             DateTime?
  avisoExpiracaoEnviadoEm DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  matricula       Matricula           @relation(fields: [matriculaId], references: [id], onDelete: Restrict)
  transacaoOrigem HotmartTransaction? @relation("VigenciaTransacaoOrigem", fields: [transacaoOrigemId], references: [id], onDelete: Restrict)

  @@index([matriculaId])
  @@index([matriculaId, status])
  @@index([status])
  @@index([iniciaEm])
  @@index([expiraEm])
}

model AlunoAccessToken {
  id        String    @id @default(cuid())
  alunoId   String
  tokenHash String    @unique
  tipo      String
  expiraEm  DateTime
  usadoEm   DateTime?
  createdAt DateTime  @default(now())

  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@index([alunoId])
  @@index([expiraEm])
}

model PerfilAluno {
  id                 String             @id @default(cuid())
  alunoId            String             @unique
  nomeExibicao       String?
  fotoUrl            String?
  cidade             String?
  estado             String?
  bio                String?            @db.Text
  experiencia        String?            @db.Text
  objetivos          String?            @db.Text
  mostrarFoto        Boolean            @default(false)
  mostrarLocalizacao Boolean            @default(false)
  mostrarBio         Boolean            @default(false)
  mostrarExperiencia Boolean            @default(false)
  mostrarObjetivos   Boolean            @default(false)
  mostrarWhatsapp    Boolean            @default(false)
  visibilidade       VisibilidadePerfil @default(PRIVADO)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)
}

// Enum para os perfis de acesso do painel admin
enum Role {
  ADMIN
  PARCEIRO
  FORNECEDOR
}

// Tabela de usuários do painel admin
model AdminUser {
  id                       String    @id @default(cuid())
  nome                     String
  email                    String    @unique
  senha                    String
  role                     Role      @default(PARCEIRO)
  ativo                    Boolean   @default(true)
  podeGerenciarSucatas     Boolean   @default(false)
  podeGerenciarDepoimentos Boolean   @default(false)
  podeGerenciarJornada     Boolean   @default(false)
  mustChangePassword       Boolean   @default(false)
  passwordChangedAt        DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  pessoaId                 String?   @unique
  pessoa                   Pessoa?   @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
}

// Tabela para gerenciar os valores das sucatas
model SucataItem {
  id                String   @id @default(cuid())
  nome              String // Ex: Placa de Celular
  categoria         String // Ex: Eletrônicos, Catalisadores
  valorKg           Float // Valor por KG em Reais
  metais            String // Metais presentes (ex: Ouro, Prata)
  imagemUrl         String? // Opcional: link para imagem
  ativo             Boolean  @default(true)
  ultimaAtualizacao DateTime @default(now()) @updatedAt
  atualizadoPor     String? // ID do AdminUser que atualizou
}

// Tabela para gerenciar os depoimentos
model Depoimento {
  id        String   @id @default(cuid())
  nome      String // Nome do aluno
  texto     String   @db.Text
  videoUrl  String? // Opcional: link do YouTube/Vimeo
  imagemUrl String? // Opcional: foto do aluno
  aprovado  Boolean  @default(false) // Para moderação
  destaque  Boolean  @default(false) // Aparecer na home
  createdAt DateTime @default(now())
}

// Catálogo comercial interno do MGU.
// Produto representa a identidade comercial interna e não o identificador de qualquer plataforma externa.
model Produto {
  id               String      @id @default(cuid())
  nome             String
  slug             String      @unique
  descricao        String?     @db.Text
  tipo             TipoProduto
  ativo            Boolean     @default(true)
  preco            Decimal?    @db.Decimal(12, 2)
  precoPromocional Decimal?    @db.Decimal(12, 2)
  moeda            String      @default("BRL")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  integracoes       ProdutoIntegracao[]
  transacoesHotmart HotmartTransaction[]
  direitos          ProdutoDireito[]

  @@index([tipo])
  @@index([ativo])
}

// Vínculos entre um Produto interno e os identificadores utilizados
// por provedores externos.
model ProdutoIntegracao {
  id         String          @id @default(cuid())
  produtoId  String
  provedor   ProvedorProduto
  externalId String
  ativo      Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@unique([provedor, externalId])
  @@index([produtoId])
  @@index([ativo])
}

// Politica comercial de direitos configurados para um Produto.
model ProdutoDireito {
  id           String             @id @default(cuid())
  produtoId    String
  tipo         TipoDireitoProduto
  nivel        NivelEcossistema?
  configuracao Json?
  ativo        Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  produto    Produto            @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  concessoes DireitoConcedido[]

  @@unique([produtoId, tipo])
  @@index([tipo])
  @@index([ativo])
}

// Concessao concreta produzida por uma origem comercial.
// Aluno representa temporariamente a conta/credencial; Matricula permanece educacional.
model DireitoConcedido {
  id                String                 @id @default(cuid())
  alunoId           String
  produtoDireitoId  String
  transacaoOrigemId String?
  origem            OrigemDireitoConcedido
  status            StatusDireitoConcedido @default(ATIVO)
  concedidoEm       DateTime
  iniciaEm          DateTime
  expiraEm          DateTime?
  revogadoEm        DateTime?
  statusAlteradoEm  DateTime               @default(now())
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  aluno           Aluno               @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  produtoDireito  ProdutoDireito      @relation(fields: [produtoDireitoId], references: [id], onDelete: Restrict)
  transacaoOrigem HotmartTransaction? @relation(fields: [transacaoOrigemId], references: [id], onDelete: Restrict)

  @@unique([produtoDireitoId, transacaoOrigemId])
  @@index([alunoId])
  @@index([produtoDireitoId])
  @@index([transacaoOrigemId])
  @@index([status])
  @@index([alunoId, status])
}

// Modulos internos do Ecossistema MGU.
// nivelMinimo define o menor nivel efetivo necessario para acesso.
model EcoModulo {
  id          String           @id @default(cuid())
  nome        String
  slug        String           @unique
  ativo       Boolean          @default(true)
  nivelMinimo NivelEcossistema
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  recursos EcoModuloRecurso[]

  @@index([ativo])
  @@index([nivelMinimo])
}

// Recursos pertencentes a um modulo do Ecossistema.
// O codigo identifica o recurso dentro do respectivo modulo.
model EcoModuloRecurso {
  id          String           @id @default(cuid())
  moduloId    String
  codigo      String
  nivelMinimo NivelEcossistema
  ativo       Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  modulo EcoModulo @relation(fields: [moduloId], references: [id], onDelete: Restrict)

  @@unique([moduloId, codigo])
  @@index([moduloId])
  @@index([ativo])
  @@index([nivelMinimo])
}

// Auditoria e idempotência dos eventos recebidos da Hotmart.
// Não armazena o payload completo para evitar guardar dados sensíveis desnecessários.
model HotmartWebhookEvent {
  id                String    @id @default(cuid())
  hotmartEventId    String    @unique
  evento            String
  versao            String?
  transacaoCodigo   String?
  // Identificador externo do produto recebido da Hotmart.
  // Campo legado/histórico: não representa Produto.id.
  produtoId         String?
  criadoNaHotmartEm DateTime?
  recebidoEm        DateTime  @default(now())
  processadoEm      DateTime?
  erroProcessamento String?

  @@index([transacaoCodigo])
  @@index([produtoId])
  @@index([evento])
}

// Estado mais recente de cada transação Hotmart.
// O código da transação impede que o mesmo pedido gere uma venda duplicada.
model HotmartTransaction {
  id                    String    @id @default(cuid())
  transacaoCodigo       String    @unique
  leadId                String?
  alunoId               String?
  matriculaId           String?
  emailComprador        String?
  // Identificador externo do produto recebido da Hotmart.
  // Campo legado/histórico: não representa Produto.id.
  produtoId             String
  // Referência opcional à identidade comercial interna do MGU.
  produtoCatalogoId     String?
  produtoUcode          String?
  produtoNome           String
  status                String
  valorBruto            Decimal   @db.Decimal(12, 2)
  moeda                 String    @default("BRL")
  formaPagamento        String?
  parcelas              Int?
  origemSrc             String?
  origemSck             String?
  origemXcod            String?
  aprovadoEm            DateTime?
  ultimoEventoHotmartEm DateTime?
  ultimoEventoHotmartId String?
  criadoEm              DateTime  @default(now())
  atualizadoEm          DateTime  @updatedAt

  lead               Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  aluno              Aluno?             @relation(fields: [alunoId], references: [id], onDelete: SetNull)
  matricula          Matricula?         @relation(fields: [matriculaId], references: [id], onDelete: SetNull)
  vigenciaOrigem     VigenciaMatricula? @relation("VigenciaTransacaoOrigem")
  produtoCatalogo    Produto?           @relation(fields: [produtoCatalogoId], references: [id], onDelete: SetNull)
  direitosConcedidos DireitoConcedido[]

  @@index([leadId])
  @@index([alunoId])
  @@index([matriculaId])
  @@index([emailComprador])
  @@index([produtoId])
  @@index([produtoCatalogoId])
  @@index([status])
  @@index([criadoEm])
}

model Pessoa {
  id                String   @id @default(cuid())
  nome              String
  emailPrincipal    String   @unique
  telefonePrincipal String?
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  lead      Lead?
  aluno     Aluno?
  adminUser AdminUser?
}
